      - name: Import Secrets using CyberArk Conjur Secret Fetcher
        uses: cyberark/conjur-action@v2.0.6
        with:
          url: https://demo.secretsmgr.cyberark.cloud/api
          account: conjur
          authn_id: github_sa
          secrets: data/vault/cyberarkshop-automation-demo/cyberarkshop-trust-anchor/password|CERT_PAYLOAD

      - name: Save PEM Certificate to File and Verify
        run: |
          cat << 'EOF' > trust-anchor.pem
          ${{ env.CERT_PAYLOAD }}
          EOF
          if [ -s trust-anchor.pem ]; then
            echo "Success: trust-anchor.pem created successfully."
            openssl x509 -in trust-anchor.pem -text -noout | grep -E "Issuer:|Subject:|Not After :"
          else
            echo "Error: Certificate file is empty."
            exit 1
          fi
